# ── Telegram Bot (from @BotFather) ──
TELEGRAM_BOT_TOKEN=your_bot_token

# ── Telegram Chat Group ──
TELEGRAM_CHAT_ID=@YellowKorea_chat

# ── Owner (for daily summary DM) ──
# Your numeric Telegram user ID. Send /myid to the bot in a private chat to get it.
OWNER_TELEGRAM_ID=

# ── Anthropic Claude API ──
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Twitter/X ──
TWITTER_USERNAME=Yellow__Korea
TWITTER_MAIN_USERNAME=yellow
# Get free Bearer Token from https://developer.twitter.com
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ── Intervals (minutes) ──
TWITTER_SCRAPE_INTERVAL_MINUTES=5
# Auto-post is gated by activity; default checks every 4h, ~2-3 posts/day.
AUTO_POST_INTERVAL_MINUTES=240
MIN_HUMAN_MSGS_BEFORE_POST=8
MAX_AUTO_POSTS_PER_DAY=3

# ── Moderation / anti-spam ──
# delete = delete + warn + mute repeat offenders | report = log only | off = disabled
SPAM_ACTION=delete
SPAM_MUTE_THRESHOLD=3
SPAM_MUTE_MINUTES=60

# ── Daily report (KST hour, 0-23) ──
DAILY_REPORT_HOUR_KST=9
