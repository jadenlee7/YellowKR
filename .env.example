# ── Telegram Bot (from @BotFather) ──
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Telegram API (from https://my.telegram.org/apps) ──
# Required for scraping @YellowKorea_ann channel
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+821012345678

# ── Optional: OpenAI API key for AI-powered chat ──
# Leave empty to use keyword-based responses
OPENAI_API_KEY=

# ── Channel to Monitor ──
YELLOW_ANN_CHANNEL=YellowKorea_ann

# ── Scrape Interval (minutes) ──
SCRAPE_INTERVAL_MINUTES=3

# ── Auto-engagement: Yellow Tips Interval (minutes) ──
AUTO_TIP_INTERVAL_MINUTES=60

# ── Welcome delay (seconds) ──
WELCOME_DELAY_SECONDS=2
