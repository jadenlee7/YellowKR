# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Twitter/X API Credentials (Twitter API v2)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Optional: OpenAI API key for AI-powered chat (leave empty to use rule-based responses)
OPENAI_API_KEY=

# Yellow Korea Telegram Announcement Channel
YELLOW_ANN_CHANNEL=@YellowKorea_ann

# Twitter account to monitor
TWITTER_USERNAME=Yellow__Korea

# Scrape interval in minutes
SCRAPE_INTERVAL_MINUTES=5

# Language (ko/en)
BOT_LANGUAGE=ko
