# ── Telegram Bot (from @BotFather) ──
TELEGRAM_BOT_TOKEN=your_bot_token

# ── Telegram Chat Group ──
TELEGRAM_CHAT_ID=@YellowKorea_chat

# ── Telegram API (from https://my.telegram.org/apps) ──
# Required for scraping @YellowKorea_ann channel
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+821012345678

# ── Anthropic Claude API ──
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Source Channel ──
YELLOW_ANN_CHANNEL=YellowKorea_ann

# ── Twitter/X Account to Scrape ──
TWITTER_USERNAME=Yellow__Korea

# ── Intervals (minutes) ──
SCRAPE_INTERVAL_MINUTES=3
TWITTER_SCRAPE_INTERVAL_MINUTES=5
AUTO_TIP_INTERVAL_MINUTES=60
